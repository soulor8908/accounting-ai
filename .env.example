# 部署期环境变量（复制为 .env 或注入到构建环境；均可选）
# 说明：VITE_* 在构建时内联进 bundle；若需“不重新构建”改配置，
#       优先使用部署期 /app.config.json（见 public/app.config.example.json）。

# 试用 AI 代理 Worker 地址（前端不持有 API Key，Key 存于 Worker Secret）
# 例：https://ai-proxy.your-domain.workers.dev
VITE_TRIAL_PROXY_URL=

# 内置试用默认模型（可被部署期 app.config.json 覆盖）
VITE_DEFAULT_MODEL=agnes-2.0-flash

# 每日试用配额上限
VITE_DAILY_TRIAL_LIMIT=30

# 应用显示名（写入 document.title）
VITE_APP_NAME=智能记账AI助手
